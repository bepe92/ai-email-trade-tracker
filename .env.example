# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — do NOT commit it.

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Gmail address to poll for deal confirmations
GMAIL_ADDRESS=your.address@gmail.com

# Gmail App Password (https://myaccount.google.com/apppasswords — 2FA must be enabled).
# Strip spaces when pasting: "abcd efgh ijkl mnop" -> "abcdefghijklmnop"
GMAIL_APP_PASSWORD=your-16-char-app-password

# Optional: identity shown in the review UI
# REVIEWER_EMAIL=trader@shell.com
